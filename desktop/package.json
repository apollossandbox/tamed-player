{
  "name": "tamed-player",
  "productName": "Compass",
  "version": "1.10.0",
  "description": "Compass: music library, CD creator, audio tools and DAW launcher.",
  "author": "trulytamed",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prepare-app": "node make-page.js",
    "start": "npm run prepare-app && electron .",
    "dist": "./build-win.sh"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.trulytamed.tamedplayer",
    "productName": "Compass",
    "copyright": "trulytamed and KGB",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "fl/**/*",
      "online.js",
      "online.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Compass-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Compass",
      "deleteAppDataOnUninstall": false
    }
  }
}
